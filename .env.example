# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=outreach
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async SQLAlchemy URL (hostname "postgres" = Docker service name)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/outreach

# ── ChromaDB ────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── RAG (cloud embeddings only — no local models) ───────
RAG_MODE=mock
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
# RAG_MODE=real
# OPENAI_API_KEY=
# RAG_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ── LLM (cloud chat only — no local models) ─────────────
LLM_MODE=mock
LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
PREMIUM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=800
# LLM_MODE=real
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Application ─────────────────────────────────────────
APP_NAME=Outreach AI Cortex
DEBUG=false

# ── Site parser (nested Settings.parser via PARSER_*) ───
PARSER_TIMEOUT=15
PARSER_MAX_RETRIES=2
PARSER_MAX_TEXT_LENGTH=50000

# ── LinkedIn (mock by default — no API key required) ────
LINKEDIN_MODE=mock
# LINKEDIN_MODE=real
# PHANTOMBUSTER_API_KEY=
# LINKEDIN_PHANTOMBUSTER_PHANTOM_ID=
