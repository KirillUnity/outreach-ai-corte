# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=outreach
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async SQLAlchemy URL (hostname "postgres" = Docker service name)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/outreach

# ── ChromaDB ────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── RAG (cloud embeddings only — no local models) ───────
RAG_MODE=mock
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
# RAG_MODE=real
# OPENAI_API_KEY=
# RAG_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ── LLM (cloud chat only — no local models) ─────────────
LLM_MODE=mock
LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
PREMIUM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=800
# LLM_MODE=real
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── LangGraph agent ─────────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_ENABLE_CHECKPOINTING=true
AGENT_REQUIRE_DELIVERABILITY_CHECK=true
AGENT_REQUIRE_HUMAN_APPROVAL=true
# AGENT_SENDER_DOMAIN=aicortex.dev

# ── Langfuse (self-hosted UI on localhost:3001) ─────────
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_NEXTAUTH_SECRET=change-me-in-production-please-32ch
LANGFUSE_SALT=change-me-too-please-use-32chars

# ── Prompt A/B (off in CI — mock LLM is deterministic) ─
PROMPT_AB_ENABLED=false

# ── Application ─────────────────────────────────────────
APP_NAME=Outreach AI Cortex
DEBUG=false

# ── Site parser (nested Settings.parser via PARSER_*) ───
PARSER_TIMEOUT=15
PARSER_MAX_RETRIES=2
PARSER_MAX_TEXT_LENGTH=50000

# ── LinkedIn (mock by default — no API key required) ────
LINKEDIN_MODE=mock
# LINKEDIN_MODE=real
# PHANTOMBUSTER_API_KEY=
# LINKEDIN_PHANTOMBUSTER_PHANTOM_ID=

# ── Neo4j (graph; heap 512m + pagecache 256m — do not raise on 8 GB RAM)
NEO4J_ENABLED=true
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please-strong-password
NEO4J_URI=bolt://neo4j:7687
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_AUTO_SYNC_ON_WRITE=false
# GRAPH_SYNC_TOKEN=  # required for POST /api/v1/graph/sync (or DEBUG=true)

# ── Deliverability (live DNS; nested Settings.deliverability) ─
DELIVERABILITY_DNS_TIMEOUT=5.0
DELIVERABILITY_DNS_LIFETIME=10.0
DELIVERABILITY_DNS_NAMESERVERS=1.1.1.1,8.8.8.8
DELIVERABILITY_CACHE_TTL_SECONDS=3600

