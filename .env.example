# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=outreach
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async SQLAlchemy URL (hostname "postgres" = Docker service name)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/outreach

# ── ChromaDB ────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── Application ─────────────────────────────────────────
APP_NAME=Outreach AI Cortex
DEBUG=false
